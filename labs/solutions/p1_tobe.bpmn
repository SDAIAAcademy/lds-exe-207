<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_p1_tobe" targetNamespace="https://sdaiaacademy.github.io/lds-exe-207/">
  <bpmn:process id="p1_tobe" name="طلبات الصيانة في رَدهة: العملية بعد إعادة التصميم (حل مرجعي)" isExecutable="false">
    <bpmn:startEvent id="start" name="طلب صيانة" />
    <bpmn:task id="B1" name="B1 · المستأجر يرسل الطلب (المستأجر)" />
    <bpmn:task id="B2" name="B2 · النموذج يفرز الطلب ويكتب الفئة والأولوية والوحدة في أمر العمل بحساب خدمة (النظام)" />
    <bpmn:task id="B3" name="B3 · قاعدة كلمات للطوارئ تعمل مع النموذج، وأي طارئ يذهب فورًا إلى المناوب ليؤكده (مشرف المناوبة)" />
    <bpmn:task id="B4" name="B4 · المنسق يؤكد الفئة والأولوية في قائمة أوامر العمل أو يصححهما (منسق الصيانة)" />
    <bpmn:task id="B5" name="B5 · إن كانت الوحدة «missing»: الموظف يتصل بالمستأجر (موظف مركز الاتصال)" />
    <bpmn:task id="B6" name="B6 · المنسق يسند الطلب إلى فني داخل نظام أوامر العمل (منسق الصيانة)" />
    <bpmn:task id="B7" name="B7 · الفني يصلح ويغلق الطلب من تطبيق الجوال (فني المقاول)" />
    <bpmn:task id="B8" name="B8 · النظام يرسل رسالة نصية إلى المستأجر (النظام)" />
    <bpmn:endEvent id="end" name="أُغلق الطلب" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="B1" />
    <bpmn:sequenceFlow id="f2" sourceRef="B1" targetRef="B2" />
    <bpmn:sequenceFlow id="f3" sourceRef="B2" targetRef="B3" />
    <bpmn:sequenceFlow id="f4" sourceRef="B3" targetRef="B4" />
    <bpmn:sequenceFlow id="f5" sourceRef="B4" targetRef="B5" />
    <bpmn:sequenceFlow id="f6" sourceRef="B5" targetRef="B6" />
    <bpmn:sequenceFlow id="f7" sourceRef="B6" targetRef="B7" />
    <bpmn:sequenceFlow id="f8" sourceRef="B7" targetRef="B8" />
    <bpmn:sequenceFlow id="f9" sourceRef="B8" targetRef="end" />
  </bpmn:process>
