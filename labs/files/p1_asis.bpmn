<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_p1_asis" targetNamespace="https://sdaiaacademy.github.io/lds-exe-207/">
  <bpmn:process id="p1_asis" name="طلبات الصيانة في رَدهة: العملية الحالية مع المشروع التجريبي" isExecutable="false">
    <bpmn:startEvent id="start" name="طلب صيانة" />
    <bpmn:task id="A1" name="A1 · المستأجر يرسل الطلب من التطبيق أو قناة المراسلة (المستأجر)" />
    <bpmn:task id="A2" name="A2 · الموظف يقرأ الرسالة واقتراح المشروع التجريبي في نافذة متصفح منفصلة (موظف مركز الاتصال)" />
    <bpmn:task id="A3" name="A3 · الموظف يعيد كتابة الفئة والأولوية في نظام أوامر العمل (موظف مركز الاتصال)" />
    <bpmn:task id="A4" name="A4 · الموظف يتصل بالمستأجر ليتأكد من رقم الوحدة (موظف مركز الاتصال)" />
    <bpmn:task id="A5" name="A5 · المنسق يراجع جدول بيانات للطوارئ بدأه أثناء التجربة (منسق الصيانة)" />
    <bpmn:task id="A6" name="A6 · المنسق يسند الطلب إلى فني برسالة في مجموعة مراسلة (منسق الصيانة)" />
    <bpmn:task id="A7" name="A7 · الفني يزور الوحدة ويصلح (فني المقاول)" />
    <bpmn:task id="A8" name="A8 · الفني يسلّم ورقة العمل، وموظف إداري يدخل الإغلاق في النظام (موظف إداري)" />
    <bpmn:task id="A9" name="A9 · النظام يرسل رسالة نصية إلى المستأجر (النظام)" />
    <bpmn:endEvent id="end" name="أُغلق الطلب" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="A1" />
    <bpmn:sequenceFlow id="f2" sourceRef="A1" targetRef="A2" />
    <bpmn:sequenceFlow id="f3" sourceRef="A2" targetRef="A3" />
    <bpmn:sequenceFlow id="f4" sourceRef="A3" targetRef="A4" />
    <bpmn:sequenceFlow id="f5" sourceRef="A4" targetRef="A5" />
    <bpmn:sequenceFlow id="f6" sourceRef="A5" targetRef="A6" />
    <bpmn:sequenceFlow id="f7" sourceRef="A6" targetRef="A7" />
    <bpmn:sequenceFlow id="f8" sourceRef="A7" targetRef="A8" />
    <bpmn:sequenceFlow id="f9" sourceRef="A8" targetRef="A9" />
    <bpmn:sequenceFlow id="f10" sourceRef="A9" targetRef="end" />
  </bpmn:process>
